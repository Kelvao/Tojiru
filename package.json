{
  "name": "tojiru",
  "version": "1.0.0",
  "private": true,
  "description": "Packs a manga folder into CBZ or EPUB, entirely in the browser",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test",
    "lint": "eslint \"src/**/*.js\" \"tests/**/*.js\"",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\"",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "eslint": "8.57.1",
    "jszip": "3.10.1",
    "prettier": "3.5.3"
  }
}
